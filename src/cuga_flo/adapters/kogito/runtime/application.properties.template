# Generated by scripts/build_kogito_app.sh — edit the template under
# src/cuga_flo/adapters/kogito/runtime/, not the generated project.
#
# Placeholders: @HTTP_PORT@

# Quarkus defaults to 8080, which the Flowable demo container also uses. Keep Kogito
# apps off it, and make sure the app's workflow_engine.url matches whatever is set here.
quarkus.http.port=@HTTP_PORT@

# The embedded Data Index pulls in OIDC and refuses to start without an auth server URL,
# even when unused. Disable the tenant and give the URL a value it will never dial.
quarkus.oidc.tenant-enabled=false
quarkus.oidc.auth-server-url=http://localhost/disabled

# The Kogito Management Console is a browser app served from its own port, so its calls to
# this service's /graphql are cross-origin — without CORS the browser drops the response
# and the console reports "Could not communicate with runtime". Any localhost port is
# allowed; tighten this before exposing a service beyond a dev machine.
quarkus.http.cors=true
quarkus.http.cors.origins=/https?://localhost(:[0-9]+)?/
quarkus.http.cors.methods=GET,POST,OPTIONS
quarkus.http.cors.headers=content-type,authorization

# Recorded on every instance as `serviceUrl` and used by the Management Console to call
# back into this service — for the instance detail view and for actions like abort and
# retry. Left unset it is null, and the console fails with "Error fetching data" and
# "missing the kogito.service.url property". This is the URL as the *browser* resolves it.
kogito.service.url=http://localhost:@HTTP_PORT@

# `POST /{processId}` runs the whole process — every control point, including any A2A
# round trip a task delegates to — inside ONE JTA transaction (ProcessServiceImpl.
# createProcessInstance is @Transactional). Quarkus/Narayana's default transaction
# timeout is 60s; the reaper aborts the transaction in the background once that elapses,
# even though the business logic keeps running. The process finishes "successfully" but
# the final Data Index write then fails with ARJUNA016102 ("transaction is not active")
# and the REST call surfaces it as a 500 — nothing CugaFlo.java's or KogitoProxy's own
# HTTP timeouts can prevent, since this is a server-side transaction, not an HTTP one.
# Keep at or above KogitoProxy._FALLBACK_TIMEOUT.
quarkus.transaction-manager.default-transaction-timeout=1200
